:root {
  color-scheme: light;

  --theme-color-background:rgb(219, 214, 208);
  --theme-color-text:rgb(39, 39, 39);
  --theme-color-text-secondary: #12121290;
  --theme-color-text-tertiary: #12121275;
  --theme-color-button-background: #1a5cff;
  --theme-color-button-background-hover: #164bcc;
  --theme-color-button-text: #ffffff;
  --theme-color-shadow: rgba(0, 0, 0, 0.1);
  --theme-color-overlay: rgba(219, 214, 208, 0.6);
  --theme-color-border: rgba(58, 55, 55, 0.09);
  --theme-color-online:rgb(75, 167, 0);
  --theme-color-background-sidebar:rgb(199, 192, 184);
  --theme-scrollbar-color: rgba(0, 0, 0, 0.1);
  --theme-color-background-darken: rgba(0, 0, 0, 0.05);
  --theme-color-overlay-inverted: rgba(255, 255, 255, 0.05);

  @media (prefers-color-scheme: dark) {
    color-scheme: dark;

    --theme-color-background: #1d1d22;
    --theme-color-text: #dedede;
    --theme-color-text-secondary: #dedede75;
    --theme-color-text-tertiary: #dedede25;
    --theme-color-shadow: rgba(0, 0, 0, 0.3);
    --theme-color-overlay: rgba(0, 0, 0, 0.5);
    --theme-color-border: rgba(149, 169, 245, 0.05);
    --theme-color-background-sidebar: #1a1a1f;
    --theme-scrollbar-color: rgba(255, 255, 255, 0.03);
    --theme-color-background-darken: rgba(0, 0, 0, 0.1);
    --theme-color-overlay-inverted: rgba(255, 255, 255, 0.05);
  }
}
